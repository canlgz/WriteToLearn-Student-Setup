/**
 * Programmatic Rich Menu setup（write-to-learn 三相導航·2×3＋底列）.
 *
 *   ① 隨手寫：🎒 探索寫(/explore，開鍵盤預填；合併隨手記) / 📌 目前記事(/now)
 *   ② 查脈絡：🧶 看脈絡(/themes) / 💬 問一下(/ask，預填)
 *   ③ 生歷程：🌳 學習歷程(/journey) / 📚 學習總冊(/portfolio)
 *   底列：🔍 回想(/recall，預填) · 🧭 我的學習(/me) · ℹ️ 說明(/help)
 * 帶參數指令用 postback inputOption:'openKeyboard'+fillInText 預填。
 * 部署（免 editor）：白名單 action `richmenu.setup`（_cmd.txt）→ deleteAllRichMenus()+setupRichMenu()。
 * 圖由 tools/gen_richmenu.py 產生並寫回本檔。
 */

const RICHMENU_DEF = {
  size: { width: 2500, height: 1686 },
  selected: true,
  name: 'wL-main',
  chatBarText: '選單 ⌄',
  areas: [
    { bounds: { x: 40, y: 420, width: 780, height: 510 }, action: { type: 'postback', data: 'action=noop', inputOption: 'openKeyboard', fillInText: '/explore ' } },
    { bounds: { x: 40, y: 950, width: 780, height: 510 }, action: { type: 'message', text: '/now' } },
    { bounds: { x: 860, y: 420, width: 780, height: 510 }, action: { type: 'message', text: '/themes' } },
    { bounds: { x: 860, y: 950, width: 780, height: 510 }, action: { type: 'postback', data: 'action=noop', inputOption: 'openKeyboard', fillInText: '/ask ' } },
    { bounds: { x: 1680, y: 420, width: 780, height: 510 }, action: { type: 'message', text: '/journey' } },
    { bounds: { x: 1680, y: 950, width: 780, height: 510 }, action: { type: 'message', text: '/portfolio' } },
    { bounds: { x: 0, y: 1480, width: 833, height: 206 }, action: { type: 'postback', data: 'action=noop', inputOption: 'openKeyboard', fillInText: '/recall ' } },
    { bounds: { x: 833, y: 1480, width: 833, height: 206 }, action: { type: 'message', text: '/me' } },
    { bounds: { x: 1666, y: 1480, width: 833, height: 206 }, action: { type: 'message', text: '/help' } }
  ]
};

// Base64 of tools/gen_richmenu.py 產出的 2500×1686 PNG。
const RICHMENU_PNG_BASE64 = '';

function setupRichMenu() {
  const token = getProp_(PROP.LINE_CHANNEL_ACCESS_TOKEN);

  // 1. Create
  const createRes = UrlFetchApp.fetch('https://api.line.me/v2/bot/richmenu', {
    method: 'post',
    contentType: 'application/json',
    headers: { Authorization: `Bearer ${token}` },
    payload: JSON.stringify(RICHMENU_DEF),
    muteHttpExceptions: true
  });
  if (createRes.getResponseCode() >= 300) {
    throw new Error(`Create richmenu failed: ${createRes.getResponseCode()} ${createRes.getContentText()}`);
  }
  const richMenuId = JSON.parse(createRes.getContentText()).richMenuId;
  console.log('Created richMenuId:', richMenuId);

  // 2. Upload image（使用者原圖＝JPEG；2500×1686、<1MB）
  const bytes = Utilities.base64Decode(RICHMENU_PNG_BASE64);
  const uploadRes = UrlFetchApp.fetch(`https://api-data.line.me/v2/bot/richmenu/${richMenuId}/content`, {
    method: 'post',
    contentType: 'image/jpeg',
    headers: { Authorization: `Bearer ${token}` },
    payload: bytes,
    muteHttpExceptions: true
  });
  if (uploadRes.getResponseCode() >= 300) {
    throw new Error(`Upload richmenu image failed: ${uploadRes.getResponseCode()} ${uploadRes.getContentText()}`);
  }
  console.log('Image uploaded.');

  // 3. Set as default for all users
  const defRes = UrlFetchApp.fetch(`https://api.line.me/v2/bot/user/all/richmenu/${richMenuId}`, {
    method: 'post',
    headers: { Authorization: `Bearer ${token}` },
    muteHttpExceptions: true
  });
  if (defRes.getResponseCode() >= 300) {
    throw new Error(`Set default richmenu failed: ${defRes.getResponseCode()} ${defRes.getContentText()}`);
  }
  console.log('Done. richMenuId set as default:', richMenuId);
  return richMenuId;
}

function listRichMenus() {
  const token = getProp_(PROP.LINE_CHANNEL_ACCESS_TOKEN);
  const res = UrlFetchApp.fetch('https://api.line.me/v2/bot/richmenu/list', {
    headers: { Authorization: `Bearer ${token}` },
    muteHttpExceptions: true
  });
  console.log(res.getContentText());
}

/**
 * Temporarily hide the bottom menu without deleting it.
 * Run from the Apps Script editor; re-run setupRichMenu() to restore.
 *   - DELETE /v2/bot/user/all/richmenu  → unset the default for all users
 * The richmenu definition + image stay on LINE's side, so the next setup
 * call won't have to re-upload.
 */
function hideRichMenu() {
  const token = getProp_(PROP.LINE_CHANNEL_ACCESS_TOKEN);
  const res = UrlFetchApp.fetch('https://api.line.me/v2/bot/user/all/richmenu', {
    method: 'delete',
    headers: { Authorization: `Bearer ${token}` },
    muteHttpExceptions: true
  });
  const code = res.getResponseCode();
  if (code >= 300) {
    console.error('hideRichMenu failed:', code, res.getContentText().slice(0, 300));
    throw new Error(`hideRichMenu failed: ${code} ${res.getContentText()}`);
  }
  console.log('Rich menu hidden (default unset). Run setupRichMenu() to bring it back.');
}

function deleteAllRichMenus() {
  const token = getProp_(PROP.LINE_CHANNEL_ACCESS_TOKEN);
  const res = UrlFetchApp.fetch('https://api.line.me/v2/bot/richmenu/list', {
    headers: { Authorization: `Bearer ${token}` },
    muteHttpExceptions: true
  });
  const list = JSON.parse(res.getContentText()).richmenus || [];
  for (const rm of list) {
    UrlFetchApp.fetch(`https://api.line.me/v2/bot/richmenu/${rm.richMenuId}`, {
      method: 'delete',
      headers: { Authorization: `Bearer ${token}` },
      muteHttpExceptions: true
    });
    console.log('Deleted', rm.richMenuId);
  }
}
